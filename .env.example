# RatePath (ريت باث) Environment Configuration
PYTHONUTF8=1

# Multi-LLM 6-Key Rotator Pool (Gemini 1..3 -> Groq 1..3 -> OpenRouter)
GEMINI_API_KEY_1=placeholder
GEMINI_API_KEY_2=placeholder
GEMINI_API_KEY_3=placeholder
GROQ_API_KEY_1=placeholder
GROQ_API_KEY_2=placeholder
GROQ_API_KEY_3=placeholder
OPENROUTER_API_KEY=placeholder

# Optional Single-Key Legacy Aliases
GEMINI_API_KEY=placeholder
GROQ_API_KEY=placeholder

# Supabase PostgreSQL + pgvector Market Memory
SUPABASE_URL=placeholder
SUPABASE_KEY=placeholder

# Upstash Serverless Redis REST
UPSTASH_REDIS_REST_URL=placeholder
UPSTASH_REDIS_REST_TOKEN=placeholder

# Telegram 4-Channel Language-Separated Broadcasting (Single Bot Token) & Admin Watchdog
TELEGRAM_BOT_TOKEN=placeholder
TELEGRAM_PUBLIC_CHANNEL_EN=placeholder
TELEGRAM_VIP_CHANNEL_EN=placeholder
TELEGRAM_PUBLIC_CHANNEL_AR=placeholder
TELEGRAM_VIP_CHANNEL_AR=placeholder
ADMIN_CHAT_ID=placeholder
MINI_APP_URL=https://ratepath.io/
PUBLIC_SITE_URL=https://ratepath.io
TELEGRAM_WEBHOOK_SECRET=placeholder

# Optional CoinMarketCap Pro API Key (falls back seamlessly to public CMC/CoinGecko/Binance feeds)
CMC_PRO_API_KEY=placeholder

# Optional Legacy Single-Channel Fallbacks (kept for backward compatibility)
TELEGRAM_PUBLIC_CHANNEL=placeholder
TELEGRAM_VIP_CHANNEL=placeholder
