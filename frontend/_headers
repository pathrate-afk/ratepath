# RatePath (ريت باث) — Cloudflare Pages Security & Optimal Cache Headers

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self' https://telegram.org https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://s2.coinmarketcap.com https://assets.coingecko.com https://coin-images.coingecko.com https://cdn.dexscreener.com https://dd.dexscreener.com; connect-src 'self' https://raw.githubusercontent.com https://*.supabase.co https://cloudflareinsights.com; frame-src https://ad.a-ads.com; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex

/ar
  Cache-Control: public, max-age=0, must-revalidate

/en
  Cache-Control: public, max-age=0, must-revalidate

/api/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8

/monetization.config.js
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/styles/*
  Cache-Control: public, max-age=0, must-revalidate

/public/live_feed.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=60, stale-while-revalidate=240
  Content-Type: application/json; charset=utf-8

/live_feed.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=60, stale-while-revalidate=240
  Content-Type: application/json; charset=utf-8

/public/catalog_feed.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=120, stale-while-revalidate=600
  Content-Type: application/json; charset=utf-8

/catalog_feed.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=120, stale-while-revalidate=600
  Content-Type: application/json; charset=utf-8

/server.py
  X-Robots-Tag: noindex

/logo.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=31536000, immutable
